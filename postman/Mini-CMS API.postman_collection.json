{
  "info": {
    "_postman_id": "6f32f3f8-06d3-4f20-a980-8cc50b5814a7",
    "name": "Mini-CMS API - Sessions 13-14",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" },
    { "key": "email", "value": "test@example.com", "type": "string" },
    { "key": "password", "value": "password", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "post_id", "value": "1", "type": "string" },
    { "key": "category_id", "value": "1", "type": "string" },
    { "key": "tag_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Connexion - obtenir un jeton",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('token', pm.response.json().token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"postman\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": ["{{base_url}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "Lister les catégories",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/categories",
          "host": ["{{base_url}}"],
          "path": ["api", "categories"]
        }
      }
    },
    {
      "name": "Lister les articles filtrés",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/posts?per_page=10&category_id={{category_id}}&tag_id={{tag_id}}&include%5B%5D=body&include%5B%5D=tags",
          "host": ["{{base_url}}"],
          "path": ["api", "posts"],
          "query": [
            { "key": "per_page", "value": "10" },
            { "key": "category_id", "value": "{{category_id}}" },
            { "key": "tag_id", "value": "{{tag_id}}" },
            { "key": "include[]", "value": "body" },
            { "key": "include[]", "value": "tags" }
          ]
        }
      }
    },
    {
      "name": "Créer un article",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Article depuis Postman\",\n  \"slug\": \"article-depuis-postman\",\n  \"body\": \"Contenu assez long pour valider un article créé avec la collection Postman.\",\n  \"is_published\": true\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/posts?include%5B%5D=body",
          "host": ["{{base_url}}"],
          "path": ["api", "posts"],
          "query": [{ "key": "include[]", "value": "body" }]
        }
      }
    },
    {
      "name": "Afficher un article",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/api/posts/{{post_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "posts", "{{post_id}}"]
        }
      }
    },
    {
      "name": "Déconnexion - révoquer le jeton",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/logout",
          "host": ["{{base_url}}"],
          "path": ["api", "logout"]
        }
      }
    }
  ]
}
